# ---------------------------------------------------------
# Neon PostgreSQL
# Pooled connection: used by the running app (Prisma Client)
# Direct connection: used by Prisma Migrate / CLI operations
# ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# ---------------------------------------------------------
# Server
# ---------------------------------------------------------
PORT=5000
NODE_ENV=development

# URL of the frontend app (used for CORS + email links)
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------
# Auth
# ---------------------------------------------------------
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=1d
COOKIE_NAME=access_token

# ---------------------------------------------------------
# Resend (password reset emails)
# https://resend.com
# ---------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev

# Link base used inside the password reset email
RESET_PASSWORD_URL=http://localhost:3000/reset-password
