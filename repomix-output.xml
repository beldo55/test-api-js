const POST_TITLES = [
  "10 Tips for Writing Cleaner JavaScript",
  "Why I Switched to TypeScript (and Why You Might Too)",
  "A Beginner's Guide to REST APIs",
  "Understanding JWT Authentication in 5 Minutes",
