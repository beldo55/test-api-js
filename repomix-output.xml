      .min(1, "An order must contain at least one item"),
  }),
});

module.exports = {
  idParamSchema,
  listProductsSchema,
  createProductSchema,
  updateProductSchema,
  listPostsSchema,
  createPostSchema,
  updatePostSchema,
  createCommentSchema,
  createOrderSchema,
};
